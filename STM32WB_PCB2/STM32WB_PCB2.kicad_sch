	(text "STM32WB MCU with:\n- N_RST switch\n- SMPS Connection\n- Boot Switch\n- Two Crystal Oscillators\n- GPIO LED\n\n- UART Connector\n- Bluetooth RF Connection\n- SW Debug Tag Connector\n\n- Powered by USB_C 2.0, and 3.3V LDO"
		(exclude_from_sim no)
		(at 37.338 161.798 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "18b7ccbe-927f-4c24-9c25-e1a402d7a966")
	)
	(text "NOTE: R5 and R6 make a voltage divider.\nV_BOOT = 3.3V*(220R)/(5.1K+220R) = 3.164V"
		(exclude_from_sim no)
		(at 220.218 118.872 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "2af823ea-ba52-4f6b-9b39-0e781cd85c31")
	)
