	(text "By connecting CC1 and CC2 to 5.1K resistors to GND,\nwe indicate to the host (fx a PC), that a power-sinking \ndevice (this PCB) is connected.\n"
		(exclude_from_sim no)
		(at 35.56 258.826 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "94e55d17-c9b5-469c-83fb-63e3aa76ab61")
	)
	(text "They help with automated assembly.\nFx SMD assembly, automated tools \ncan locate the fiducial markers to \nrecognize orientation, rotation etc."
		(exclude_from_sim no)
		(at 328.93 184.15 0)
		(effects
